{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "printWidth": 100,
  "ignorePatterns": [
    "dist/**",
    "**/storybook-static/**",
    "package-lock.json",
    // Generated, with the walkthrough screenshots inlined as data URIs.
    "public/walkthrough.html",
  ],
}
